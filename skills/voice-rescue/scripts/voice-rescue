#!/bin/sh
# voice-rescue launcher: runs the CLI from this skill folder in its own locked environment.
# The environment lives in the per-user data folder, not next to the code and not in /tmp.
set -eu
skill_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -n "${VOICE_RESCUE_HOME:-}" ]; then
  data="$VOICE_RESCUE_HOME"
elif [ "$(uname -s)" = "Darwin" ]; then
  data="$HOME/Library/Application Support/voice-rescue"
else
  data="${XDG_DATA_HOME:-$HOME/.local/share}/voice-rescue"
fi
if ! command -v uv >/dev/null 2>&1; then
  echo "voice-rescue needs uv: curl -LsSf https://astral.sh/uv/install.sh | sh  (or: brew install uv)" >&2
  exit 127
fi
mkdir -p "$data"
export UV_PROJECT_ENVIRONMENT="$data/env"
export PYTHONUNBUFFERED=1  # progress lines reach a log file or an agent as they happen
exec uv run --quiet --frozen --no-dev --project "$skill_dir" \
  --python 3.12 --python-preference only-managed voice-rescue "$@"
